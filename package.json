{
  "name": "perfect-payload",
  "version": "2.0.0-beta.3",
  "type": "module",
  "description": "Lightweight JSON payload validation library with structured errors, nested validation, field paths, and customizable validation rules.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./express": {
      "types": "./dist/express.d.ts",
      "import": "./dist/express.js",
      "default": "./dist/express.js"
    },
    "./fastify": {
      "types": "./dist/fastify.d.ts",
      "import": "./dist/fastify.js",
      "default": "./dist/fastify.js"
    }
  },
  "scripts": {
    "test": "jest",
    "build": "tsc",
    "test:types": "tsc type-test.ts --noEmit --strict --module NodeNext --moduleResolution NodeNext --target ES2022 --ignoreConfig --skipLibCheck"
  },
  "files": [
    "dist"
  ],
  "jest": {
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/test.js",
      "/testingV1.js"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kiranpoojary/perfect-payload.git"
  },
  "keywords": [
    "payload-validation",
    "request-validation",
    "nodejs-validation",
    "javascript-validation",
    "api-validation",
    "object-validation",
    "json-validation",
    "schema-validation",
    "express-validation",
    "fastify-validation",
    "validator",
    "payload",
    "api",
    "data",
    "request-body",
    "express"
  ],
  "author": "Kiran Poojary",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/kiranpoojary/perfect-payload/issues"
  },
  "homepage": "https://github.com/kiranpoojary/perfect-payload#readme",
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.4",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "babel-jest": "^29.7.0",
    "express": "^5.2.1",
    "fastify": "^5.12.5",
    "jest": "^29.7.0",
    "typescript": "^7.0.2"
  }
}
